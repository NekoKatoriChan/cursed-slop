{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cursed-slop-2",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
